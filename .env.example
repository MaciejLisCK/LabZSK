# Copy to .env next to docker-compose.yml and fill in.

# Port on the host
LABZSK_PORT=8080

# Public address of LabZSK used in generated test links (without a trailing slash)
PUBLIC_URL=https://labzsk.example.edu

# First teacher account (created on the first start; more: docker compose exec labzsk node server/src/cli.js teacher <login> <password>)
TEACHER_LOGIN=prowadzacy
TEACHER_PASSWORD=

# The secret shared with Lab Manager is set in the teacher panel (Ustawienia), not here.

# true when LabZSK runs behind an HTTPS reverse proxy (nginx, Caddy, Traefik)
SECURE_COOKIES=false
TRUST_PROXY=false

# A step delivered later than this many seconds after it was made is marked as offline
OFFLINE_AFTER_SECONDS=20
